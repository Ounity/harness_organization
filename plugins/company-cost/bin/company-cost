SENTINEL_KEY = "COMPANY_COST_MANAGED"
DEFAULT_MARKETPLACE_HINT = "ounity-plugins"
LOCAL_HOSTS = ("localhost", "127.0.0.1", "::1")

TIMEOUT_SESSION_START = 3.0
TIMEOUT_HEARTBEAT = 2.0
TIMEOUT_PROMPT = 2.0
TIMEOUT_SESSION_END = 1.5
TIMEOUT_QUEUE_ITEM = 2.0
QUEUE_FLUSH_BUDGET = 3.0

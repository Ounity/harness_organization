# Wall-clock budget for the pre-send phase (git + openspec) of each hook, so the
# HTTP sends always keep their share of the hooks.json timeout.
DEADLINE_SESSION_START = 5.0
DEADLINE_USER_PROMPT = 3.0
DEADLINE_STOP = 2.0
DEADLINE_SESSION_END = 1.0
INFER_TTL = 60.0
BACKOFF_AUTH = 900

QUEUE_MAX_BYTES = 256000

#!/usr/bin/env python3
"""company-cost: Claude Code plugin helper (stdlib only, Python 3.9+).

Commands:
  company-cost setup [--url U] [--token T] [--token-stdin] [--force] [--allow-insecure]
  company-cost send-traces [on|off|status] [--force]      (default: on)
  company-cost send-openspec [on|off|status]             (default: on)
  company-cost uninstall
  company-cost status
  company-cost doctor
  company-cost hook <Event>        (called by Claude Code hooks; always silent, exit 0)
  company-cost _sync --cwd DIR     (internal detached OpenSpec sync)
"""
